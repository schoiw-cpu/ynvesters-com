---
interface Props {
  title: string;
  description: string;
  image?: string;
  pubDate?: Date;
  author?: string;
  noIndex?: boolean;
}
const {
  title,
  description,
  image = '/og-default.png',
  pubDate,
  author = 'AI Editorial Team',
  noIndex = false,
} = Astro.props;

const siteUrl = 'https://ynvesters.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="naver-site-verification" content="204d00601379ca84b4fc2aff0ab6e46432c03051" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noIndex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={pubDate ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {pubDate && <meta property="article:author" content={author} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- AdSense -->
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-2470398277326337"
      crossorigin="anonymous"></script>

    <style is:global>
      *, *::before, *::after { box-sizing: border-box; }
      :root {
        --color-bg: #ffffff;
        --color-bg2: #f8f9fa;
        --color-text: #1a1a2e;
        --color-text-muted: #6c757d;
        --color-accent: #2563eb;
        --color-accent-hover: #1d4ed8;
        --color-border: #e2e8f0;
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --font-mono: 'Fira Code', 'Cascadia Code', Consolas, monospace;
        --max-width: 720px;
        --max-width-wide: 1100px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --color-bg: #0f0f1a;
          --color-bg2: #1a1a2e;
          --color-text: #e2e8f0;
          --color-text-muted: #94a3b8;
          --color-accent: #60a5fa;
          --color-accent-hover: #93c5fd;
          --color-border: #2d3748;
        }
      }
      body {
        margin: 0;
        font-family: var(--font-sans);
        background: var(--color-bg);
        color: var(--color-text);
        line-height: 1.7;
        font-size: 1rem;
      }
      a { color: var(--color-accent); text-decoration: none; }
      a:hover { color: var(--color-accent-hover); text-decoration: underline; }
      img { max-width: 100%; height: auto; display: block; }
      pre, code { font-family: var(--font-mono); }
    </style>
  </head>
  <body>
    <header style="border-bottom: 1px solid var(--color-border); padding: 1rem 1.5rem;">
      <div style="max-width: var(--max-width-wide); margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
        <a href="/" style="font-size: 1.25rem; font-weight: 700; color: var(--color-text); text-decoration: none;">
          Ynvesters
        </a>
        <nav style="display: flex; gap: 1.5rem; font-size: 0.95rem;">
          <a href="/">Home</a>
          <a href="/posts">All Posts</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </header>

    <main style="min-height: calc(100vh - 140px);">
      <slot />
    </main>

    <footer style="border-top: 1px solid var(--color-border); padding: 2rem 1.5rem; font-size: 0.85rem; color: var(--color-text-muted);">
      <div style="max-width: var(--max-width-wide); margin: 0 auto;">
        <p style="margin: 0 0 0.75rem; font-size:0.8rem; line-height:1.6; color:var(--color-text-muted);">
          <strong>Disclaimer:</strong> Content on Ynvesters is for informational purposes only and does not constitute professional advice.
          Product pricing, features, and availability are subject to change. Always verify information directly with the vendor before making purchasing decisions.
          This site displays advertisements via Google AdSense. Advertisers have no influence over editorial content.
        </p>
        <p style="margin: 0 0 0.5rem;">
          © {new Date().getFullYear()} Ynvesters · AI Tools Discovery &amp; Comparison
        </p>
        <p style="margin: 0;">
          <a href="/about">About</a> ·
          <a href="/contact">Contact</a> ·
          <a href="/privacy">Privacy Policy</a> ·
          <a href="/terms">Terms of Use</a> ·
          <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>
