---
import { getCollection } from 'astro:content';

interface Props {
  currentId: string;
  tags?: string[];
  category?: string;
}

const { currentId, tags = [], category } = Astro.props;

// Post tags are too granular to overlap reliably ("AI Copywriting" vs "AI
// Writing Tools" never match), so relatedness is computed on topic clusters.
// Each topic lists keyword fragments matched against a post's lowercased
// title + tags + slug. Posts sharing a topic link to each other, keeping
// quality posts clustered instead of falling back to whatever is newest.
const TOPICS: Record<string, string[]> = {
  writing: ['writing', 'copywriting', 'copy.ai', 'jasper', 'writesonic', 'grammarly', 'hemingway', 'prowritingaid', 'blogging', 'blogger', 'content creation', 'content marketing', 'cold email', 'email outreach', 'gemini spark'],
  coding: ['code editor', 'coding', 'developer', 'cursor', 'copilot', 'codeium', 'windsurf', 'replit', 'github'],
  video: ['video', 'runway', 'luma', 'sora', 'synthesia', 'heygen', 'avatar', 'dubbing'],
  image: ['image generat', 'image upscal', 'midjourney', 'dall-e', 'dalle', 'ideogram', 'stable diffusion', 'krea', 'magnific', 'canva', 'figma', 'framer', 'photoroom', 'ai art', 'ai design'],
  audio: ['voice', 'audio', 'elevenlabs', 'playht', 'descript', 'podcast', 'music', 'suno', 'udio', 'transcription', 'otter', 'fireflies', 'speakz', 'text-to-speech', 'text to speech'],
  search: ['perplexity', 'ai search', 'ai overview', 'search comparison', 'search engine', 'chatgpt plus'],
  models: ['claude 3', 'gpt-4', 'gpt-4o', 'llm', 'ai model', 'sonnet', 'claude api', 'openai api', 'gemini 2'],
  productivity: ['notion', 'project management', 'linear', 'jira', 'clickup', 'zapier', 'workflow automation', 'airtable', 'task automation', 'business automation'],
  agents: ['ai agent', 'agentic', 'multi-agent', 'orchestration', 'sales automation', 'revenue ops'],
};

function topicsFor(text: string): Set<string> {
  const t = text.toLowerCase();
  const found = new Set<string>();
  for (const [topic, keys] of Object.entries(TOPICS)) {
    // Word-boundary match: bare includes() classified "Magic Studio" as audio
    // because "studio" contains "udio".
    if (keys.some((k) => new RegExp(`\\b${k.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}`).test(t))) {
      found.add(topic);
    }
  }
  return found;
}

// noindexed (soft-retired) posts must not receive internal links —
// the whole point is concentrating crawl equity on quality pages.
const all = (await getCollection('posts')).filter((p) => !p.data.noindex);

const current = all.find((p) => p.id === currentId);
const currentText = `${current?.data.title ?? ''} ${(current?.data.tags ?? []).join(' ')} ${currentId}`;
const currentTopics = topicsFor(currentText);
const tagSet = new Set(tags.map((t) => t.toLowerCase()));

const scored = all
  .filter((p) => p.id !== currentId)
  .map((p) => {
    const text = `${p.data.title} ${(p.data.tags ?? []).join(' ')} ${p.id}`;
    const pTopics = topicsFor(text);
    const sharedTopics = [...pTopics].filter((t) => currentTopics.has(t)).length;
    const sharedTags = (p.data.tags ?? []).filter((t) => tagSet.has(t.toLowerCase())).length;
    const sameCategory = p.data.category === category ? 1 : 0;
    return { post: p, score: sharedTopics * 100 + sharedTags * 10 + sameCategory };
  })
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime();
  });

// Only surface posts with a genuine topical link; never pad with unrelated
// filler just to hit a count.
const related = scored.filter((s) => s.score >= 100).slice(0, 4).map((s) => s.post);
---

{related.length > 0 && (
  <section style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--color-border);">
    <h2 style="font-size:1.25rem; font-weight:700; margin-bottom:1.25rem;">Related Articles</h2>
    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:1rem;">
      {related.map((post) => (
        <a
          href={`/posts/${post.id}`}
          style="display:block; background:var(--color-bg2); border:1px solid var(--color-border); border-radius:8px; padding:1rem 1.15rem; text-decoration:none; color:inherit;"
        >
          <span style="font-size:0.72rem; color:var(--color-accent); font-weight:600; text-transform:uppercase;">{post.data.category}</span>
          <h3 style="font-size:0.95rem; margin:0.4rem 0 0; line-height:1.4; color:var(--color-text);">{post.data.title}</h3>
        </a>
      ))}
    </div>
  </section>
)}
