---
interface Props {
  pubDate: Date;
  updatedDate?: Date;
  author?: string;
  category?: string;
}
const { pubDate, updatedDate, author = 'Ynvesters', category = 'AI Tools' } = Astro.props;

const formatted = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---

<div class="byline" style="display:flex; flex-wrap:wrap; gap:0.5rem 1.5rem; font-size:0.875rem; color:var(--color-text-muted); margin-bottom:2rem; padding-bottom:1rem; border-bottom:1px solid var(--color-border);">
  <span>By <a href="/about" style="color:var(--color-text-muted); font-weight:600;">{author}</a></span>
  <span>Published {formatted(pubDate)}</span>
  {updatedDate && <span>Updated {formatted(updatedDate)}</span>}
  <span>Category: <a href={`/category/${category.toLowerCase().replace(/\s+/g, '-')}`} style="color:var(--color-accent);">{category}</a></span>
</div>
