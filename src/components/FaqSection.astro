---
// Renders a visible FAQ block AND emits FAQPage JSON-LD from the same data —
// so answers stay in sync and AI engines / Google get structured Q&A they can
// cite directly. GEO's highest-leverage on-page element after the summary box.
interface Props {
  faq: { q: string; a: string }[];
}
const { faq } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

{faq.length > 0 && (
  <section style="margin-top:2.5rem;">
    <h2 style="font-size:1.5rem; font-weight:700; margin:0 0 1rem;">Frequently Asked Questions</h2>
    <div style="display:flex; flex-direction:column; gap:1rem;">
      {faq.map((item) => (
        <div style="border:1px solid var(--color-border); border-radius:8px; padding:1rem 1.25rem; background:var(--color-bg2);">
          <h3 style="font-size:1.05rem; font-weight:700; margin:0 0 0.4rem;">{item.q}</h3>
          <p style="margin:0; color:var(--color-text); line-height:1.7;">{item.a}</p>
        </div>
      ))}
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </section>
)}
