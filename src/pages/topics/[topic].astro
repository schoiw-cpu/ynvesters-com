---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS, TOPIC_LABELS, postTopics } from '../../lib/topics.js';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter((p) => !p.data.noindex);
  return Object.keys(TOPICS)
    .map((key) => ({
      key,
      posts: posts
        .filter((p) => postTopics(p).includes(key))
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()),
    }))
    .filter((t) => t.posts.length > 0)
    .map((t) => ({ params: { topic: t.key }, props: { key: t.key, posts: t.posts } }));
}

const { key, posts } = Astro.props;
const label = TOPIC_LABELS[key];
const formatDate = (d) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title={`${label} Reviews & Comparisons – Ynvesters`}
  description={`In-depth ${label} tool reviews, comparisons, and buying verdicts — ${posts.length} hands-on articles from Ynvesters.`}
>
  <div style="max-width: var(--max-width-wide); margin: 0 auto; padding: 2rem 1.5rem;">
    <p style="margin:0 0 0.4rem;"><a href="/topics/" style="font-size:0.9rem;">← All topics</a></p>
    <h1 style="font-size:2rem; font-weight:800; margin:0 0 0.5rem;">{label}</h1>
    <p style="color:var(--color-text-muted); margin:0 0 2rem;">{posts.length} reviews, comparisons, and verdicts.</p>

    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:1.5rem;">
      {posts.map((post) => (
        <article style="background:var(--color-bg2); border:1px solid var(--color-border); border-radius:10px; overflow:hidden;">
          {post.data.heroImage && (
            <a href={`/posts/${post.id}/`}>
              <img src={post.data.heroImage} alt={post.data.heroImageAlt ?? post.data.title} style="width:100%; height:170px; object-fit:cover;" loading="lazy" />
            </a>
          )}
          <div style="padding:1.15rem;">
            <h2 style="font-size:1rem; margin:0 0 0.5rem; line-height:1.4;">
              <a href={`/posts/${post.id}/`} style="color:var(--color-text);">{post.data.title}</a>
            </h2>
            <p style="font-size:0.85rem; color:var(--color-text-muted); margin:0 0 0.6rem; line-height:1.5;">{post.data.description}</p>
            <span style="font-size:0.8rem; color:var(--color-text-muted);">{formatDate(post.data.pubDate)}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
