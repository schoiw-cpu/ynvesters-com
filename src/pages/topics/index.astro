---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOPICS, TOPIC_LABELS, postTopics } from '../../lib/topics.js';

const posts = (await getCollection('posts')).filter((p) => !p.data.noindex);

const topics = Object.keys(TOPICS)
  .map((key) => ({
    key,
    label: TOPIC_LABELS[key],
    count: posts.filter((p) => postTopics(p).includes(key)).length,
  }))
  .filter((t) => t.count > 0)
  .sort((a, b) => b.count - a.count);
---

<BaseLayout
  title="Browse AI Tools by Topic – Ynvesters"
  description="Explore Ynvesters' AI tool reviews and comparisons by topic — writing, coding, voice, image, video, search, and more."
>
  <div style="max-width: var(--max-width-wide); margin: 0 auto; padding: 2rem 1.5rem;">
    <h1 style="font-size:2rem; font-weight:800; margin:0 0 0.5rem;">Browse by Topic</h1>
    <p style="color:var(--color-text-muted); margin:0 0 2rem;">
      Every review and comparison, grouped by what it's about.
    </p>

    <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:1rem;">
      {topics.map((t) => (
        <a
          href={`/topics/${t.key}`}
          style="display:flex; justify-content:space-between; align-items:center; background:var(--color-bg2); border:1px solid var(--color-border); border-radius:10px; padding:1.1rem 1.3rem; text-decoration:none; color:inherit;"
        >
          <span style="font-weight:700; font-size:1.05rem;">{t.label}</span>
          <span style="font-size:0.85rem; color:var(--color-text-muted);">{t.count} articles</span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
