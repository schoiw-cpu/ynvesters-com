---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact – Ynvesters"
  description="Get in touch with the Ynvesters editorial team."
>
  <div style="max-width: var(--max-width); margin: 0 auto; padding: 3rem 1.5rem;">
    <h1>Contact Us</h1>
    <p style="color:var(--color-text-muted);">
      Found an error? Want to suggest a tool for review? We'd love to hear from you.
    </p>

    <div style="background:var(--color-bg2); border:1px solid var(--color-border); border-radius:10px; padding:2rem; margin-top:2rem;">
      <p style="margin:0 0 1rem;">
        <strong>Email:</strong> <a href="mailto:schoiw@gmail.com">schoiw@gmail.com</a>
      </p>
      <p style="margin:0 0 1rem; font-size:0.9rem; color:var(--color-text-muted);">
        We aim to respond to all legitimate queries within 3–5 business days.
      </p>
      <p style="margin:0; font-size:0.9rem; color:var(--color-text-muted);">
        For advertising inquiries, please reference "Ynvesters Ad Inquiry" in the subject line.
      </p>
    </div>

    <section style="margin-top:2.5rem;">
      <h2>Editorial Corrections</h2>
      <p>
        If you believe an article contains factual errors or outdated information, please email us with:
      </p>
      <ul>
        <li>The URL of the article</li>
        <li>The specific claim that is incorrect</li>
        <li>A source link supporting the correction</li>
      </ul>
      <p>Verified corrections are typically published within 48 hours.</p>
    </section>
  </div>
</BaseLayout>
