---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdUnit from '../../components/AdUnit.astro';

const allPosts = (await getCollection('posts')).filter(p => !p.data.noindex);
const posts = allPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const categories = [...new Set(posts.map(p => p.data.category).filter(Boolean))].sort();
---

<BaseLayout
  title="All AI Tool Reviews & Guides – Ynvesters"
  description="Browse all AI tools reviews, comparisons, and guides published on Ynvesters. Updated daily."
>
  <div style="max-width: var(--max-width-wide); margin: 0 auto; padding: 2rem 1.5rem;">

    <div style="margin-bottom: 2.5rem;">
      <h1 style="font-size: 2rem; font-weight: 800; margin: 0 0 0.5rem;">All Reviews & Guides</h1>
      <p style="color: var(--color-text-muted); font-size: 1rem; margin: 0;">
        {posts.length} articles — sorted by newest first
      </p>
    </div>

    <AdUnit slot="top" />

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 2rem;">
      {posts.map((post) => (
        <article style="background: var(--color-bg2); border: 1px solid var(--color-border); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column;">
          {post.data.heroImage && (
            <a href={`/posts/${post.id}/`} style="display: block; overflow: hidden; flex-shrink: 0;">
              <img
                src={post.data.heroImage}
                alt={post.data.heroImageAlt ?? post.data.title}
                style="width: 100%; height: 180px; object-fit: cover; transition: transform 0.2s;"
                loading="lazy"
              />
            </a>
          )}
          <div style="padding: 1.25rem; display: flex; flex-direction: column; flex: 1;">
            <span style="font-size: 0.75rem; color: var(--color-accent); font-weight: 600; text-transform: uppercase; margin-bottom: 0.4rem;">
              {post.data.category}
            </span>
            <h2 style="font-size: 1rem; margin: 0 0 0.5rem; line-height: 1.4; font-weight: 700;">
              <a href={`/posts/${post.id}/`} style="color: var(--color-text); text-decoration: none;">
                {post.data.title}
              </a>
            </h2>
            <p style="font-size: 0.875rem; color: var(--color-text-muted); margin: 0 0 auto; line-height: 1.5;">
              {post.data.description}
            </p>
            <span style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.75rem; display: block;">
              {formatDate(post.data.pubDate)}
            </span>
          </div>
        </article>
      ))}
    </div>

    {posts.length === 0 && (
      <div style="text-align: center; padding: 4rem 0; color: var(--color-text-muted);">
        <p>Content launching soon. Check back tomorrow!</p>
      </div>
    )}

  </div>
</BaseLayout>
